# =============================================================================
#  Foresight · variables de entorno
#
#  Copia este archivo a `.env` y rellena los valores. `.env` está en .gitignore:
#  NUNCA subas secretos al repositorio. En Render/Docker define las variables
#  en el panel del servicio o con `--env-file`; el servidor las lee desde
#  process.env al arrancar (ver server/config.ts).
#
#  Todo tiene valores por defecto razonables para desarrollo local. Para
#  producción, como mínimo necesitas: APP_URL, SESSION_SECRET, ADMIN_EMAILS
#  y DATABASE_URL.
# =============================================================================


# -----------------------------------------------------------------------------
#  Aplicación
# -----------------------------------------------------------------------------

# Nombre visible de la plataforma (título, correos, etc.).
APP_NAME=Foresight

# URL pública (con https://) donde está desplegada la app. Se usa para construir
# los enlaces mágicos de inicio de sesión que se envían por correo y para las
# cookies de sesión. En Render es la URL que te asigna, p. ej.
# https://foresight.onrender.com. En local puedes dejarla vacía
# (por defecto http://localhost:PORT).
APP_URL=

# Puerto HTTP en el que escucha el servidor (API + cliente + WebSocket).
# Render y la mayoría de hosts lo inyectan automáticamente.
PORT=5000

# Secreto con el que se firman las cookies de sesión. Mínimo 32 bytes
# aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si está vacío se genera uno aleatorio en cada arranque, lo que cierra la
# sesión de TODOS los usuarios cada vez que el servidor se reinicia.
# OBLIGATORIO en producción.
SESSION_SECRET=

# Lista de correos (separados por comas) con rol de administrador.
# Los administradores:
#   - publican mercados al instante (sin pasar por revisión),
#   - revisan (aprueban / rechazan / destacan) los mercados de otros usuarios,
#   - resuelven mercados indicando el resultado ganador,
#   - procesan los retiros pendientes desde el panel de administración.
# El rol se asigna al iniciar sesión con ese correo (Google, Apple o enlace).
ADMIN_EMAILS=tu-correo@ejemplo.com


# -----------------------------------------------------------------------------
#  Autenticación
#  Los tres métodos son opcionales e independientes. Sin GOOGLE_CLIENT_ID ni
#  APPLE_CLIENT_ID sólo se muestra el acceso por correo (enlace mágico).
# -----------------------------------------------------------------------------

# Google Identity Services. Client ID de tipo "Aplicación web" creado en
# Google Cloud Console → APIs y servicios → Credenciales → Crear credenciales
# → ID de cliente de OAuth. En "Orígenes de JavaScript autorizados" añade
# APP_URL (y http://localhost:5000 para desarrollo). No hace falta secreto:
# el servidor sólo verifica el ID token que devuelve Google.
GOOGLE_CLIENT_ID=

# Sign in with Apple. Requiere pertenecer al Apple Developer Program (de pago).
# Es el identificador del "Services ID" (p. ej. com.tudominio.foresight.web)
# creado en Certificates, Identifiers & Profiles → Identifiers, con la
# capacidad "Sign in with Apple" activada. En su configuración añade el dominio
# de APP_URL en "Domains" y APP_URL en "Return URLs". Apple exige https, así
# que no funciona en localhost.
APPLE_CLIENT_ID=

# Modo pre-lanzamiento: con "1" (valor por defecto) basta con escribir el correo
# para crear la cuenta e iniciar sesión al instante, sin enlace ni código de
# verificación. Pon "0" cuando salgas a producción para exigir el enlace mágico.
INSTANT_EMAIL_LOGIN=1

# Envío de enlaces mágicos por correo a través de https://resend.com
# (plan gratuito suficiente). Si RESEND_API_KEY está vacío la app funciona en
# "modo demo": no envía correos y muestra el enlace de acceso directamente en
# pantalla (útil para probar, NO para producción porque cualquiera podría
# entrar con cualquier correo).
RESEND_API_KEY=

# Remitente de los correos. Con el dominio de pruebas de Resend puedes usar
# "Foresight <onboarding@resend.dev>" (sólo envía a tu propio correo).
# Para enviar a cualquier usuario verifica tu dominio en Resend y usa una
# dirección de ese dominio.
EMAIL_FROM=Foresight <onboarding@resend.dev>


# -----------------------------------------------------------------------------
#  Blockchain · depósitos y retiros de USDC
# -----------------------------------------------------------------------------

# Red en la que se aceptan depósitos y se pagan retiros. Valores:
#   polygon       Polygon PoS (mainnet, USDC real)
#   amoy          Polygon Amoy (testnet)              ← por defecto
#   base          Base (mainnet, USDC real)
#   base-sepolia  Base Sepolia (testnet)
# En testnet existe un grifo (faucet) que acredita 1000 USDC de prueba al
# saldo interno para poder probar la plataforma sin fondos reales.
CHAIN=amoy

# Nodo RPC opcional. Por defecto se usa el RPC público de la red, que tiene
# límites de peticiones estrictos. En producción usa un proveedor con plan
# gratuito (Alchemy, Infura, QuickNode…), p. ej.
# https://polygon-mainnet.g.alchemy.com/v2/TU_CLAVE
RPC_URL=

# Frase mnemónica BIP-39 (12 o 24 palabras) de la que se DERIVAN las
# direcciones de depósito de todos los usuarios (una por usuario). Quien tenga
# esta frase controla todos los fondos depositados. Genérala UNA sola vez:
#   node -e "console.log(require('ethers').Wallet.createRandom().mnemonic.phrase)"
# Guárdala en un gestor de secretos y haz una copia de seguridad fuera de línea.
# Si la cambias, las direcciones de depósito de los usuarios cambian y los
# fondos de las antiguas sólo se recuperan con la mnemónica anterior.
# Si se deja vacía, el servidor genera una al arrancar y la guarda junto con el
# estado (DATABASE_URL / DATA_FILE): si pierdes ese estado, pierdes el acceso a
# los depósitos. En producción defínela SIEMPRE de forma explícita.
DEPOSIT_MNEMONIC=

# Clave privada (hex, con o sin 0x) de la wallet "tesorería" que paga los
# retiros. Debe tener USDC de la red elegida y moneda nativa para el gas
# (POL en Polygon, ETH en Base). Mantén en ella sólo el saldo operativo
# necesario y recárgala periódicamente. Si se deja vacía, los retiros quedan
# en estado "pendiente" y un administrador los paga a mano desde otra wallet
# y los marca como enviados (con el hash de la transacción) desde el panel.
TREASURY_PRIVATE_KEY=

# 1 = el servidor vigila la blockchain y acredita automáticamente los USDC
#     que llegan a las direcciones de depósito (tras N confirmaciones).
# 0 = desactiva el observador de depósitos (p. ej. en CI o en entornos sin
#     acceso a un RPC).
DEPOSITS_ENABLED=1


# -----------------------------------------------------------------------------
#  Persistencia
#  Todo el estado (usuarios, mercados, operaciones, saldos…) se guarda como un
#  documento JSON tras cada cambio. Elige UNA de las dos opciones.
# -----------------------------------------------------------------------------

# Cadena de conexión a Postgres. Recomendado en producción. Funciona con el
# plan gratuito de https://neon.tech: crea un proyecto y copia la
# "connection string" (incluye ?sslmode=require). La tabla `app_state` se crea
# automáticamente. Formato:
#   postgresql://usuario:contraseña@host.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Alternativa sin base de datos: ruta del archivo JSON donde se guarda el
# estado cuando DATABASE_URL está vacío. Válido en local o con un volumen
# Docker. En hosts gratuitos (Render, Fly, Railway…) el disco es EFÍMERO y se
# borra en cada despliegue o reinicio: usa DATABASE_URL.
DATA_FILE=data/state.json


# -----------------------------------------------------------------------------
#  Entorno
# -----------------------------------------------------------------------------

# "production" sirve el cliente compilado desde dist/public y activa las
# cookies seguras. En desarrollo (`npm run dev`) déjalo vacío para usar Vite
# con recarga en caliente. `npm start` ya lo define automáticamente.
NODE_ENV=
